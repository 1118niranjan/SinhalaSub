# SinhalaSub configuration.
# Copy this file to ".env" and fill in your values.
# NEVER commit the real .env - it is listed in .gitignore.

# Optional: enables the OpenSubtitles search panel when set.
OPENSUBTITLES_API_KEY=

# Claude model used for translation. Leave EMPTY for "CLI default" - the same
# engine as the very first version, recommended for best quality. Or set:
# opus (highest quality), sonnet (faster), haiku (fastest).
SINHALASUB_MODEL=

# Default subtitle colour written into the .srt as <font color> tags,
# e.g. #FFD700 for yellow. Leave empty for the player's default colour.
SINHALASUB_COLOR=

# How many batches to translate in parallel (1-6). Higher = faster.
SINHALASUB_WORKERS=3

# Cues per claude call.
SINHALASUB_BATCH_SIZE=30

# Seconds allowed per claude call before it is retried.
SINHALASUB_TIMEOUT=600
