# SinhalaSub configuration - OPTIONAL.
#
# You do not need this file at all: the default engine (Google Translate) is
# free and needs no key, and everything here can also be set inside the app
# under Providers -> Settings. Copy this file to ".env" only if you prefer
# configuring by file. A real ".env" is gitignored and never committed.

# Which engine translates. One of:
#   google  - Google Translate, free, no key           (default)
#   hybrid  - Google + Claude polish on the hard lines (needs the Claude CLI)
#   openai  - OpenRouter / OpenAI / Gemini / local model (needs the block below)
SINHALASUB_PROVIDER=google

# ---- OpenRouter / OpenAI / Gemini / local model (provider = openai) --------
# Leave the key empty for local models (Ollama, LM Studio) - they need none.
OPENAI_API_KEY=
# Endpoint to talk to. Pick the one matching your service:
#   OpenRouter -> https://openrouter.ai/api/v1
#   OpenAI     -> https://api.openai.com/v1
#   Gemini     -> https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama     -> http://localhost:11434/v1
#   LM Studio  -> http://localhost:1234/v1
OPENAI_BASE_URL=https://openrouter.ai/api/v1

# ---- Optional: OpenSubtitles film search ----------------------------------
# Get a free key at https://www.opensubtitles.com/en/consumers
OPENSUBTITLES_API_KEY=

# ---- Optional tuning -------------------------------------------------------
# Default subtitle colour written as <font color> tags, e.g. #FFD700.
SINHALASUB_COLOR=
# How many requests run at once. Higher is faster.
SINHALASUB_WORKERS=10
# Cues per request. Leave unset to size batches automatically.
SINHALASUB_BATCH_SIZE=30
# Seconds allowed per request before it is retried.
SINHALASUB_TIMEOUT=600
